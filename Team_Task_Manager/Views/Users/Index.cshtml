<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@model IEnumerable<UserDetailsViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>All Users</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserRole)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserRole)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
           
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
           

            <td>
                    <a asp-action="Details" class="btn btn-primary" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" class="btn btn-warning" asp-route-id="@item.Id">Edit</a> |
                    <form asp-controller="Users"
                          asp-action="DeleteConfirmed"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline;">
                        <button type="button"
                                class="btn btn-danger"
                                onclick="confirmDelete(this)">
                            Delete
                        </button>
                    </form>
            </td>
        </tr>
}
    </tbody>
</table>
<script>
    function confirmDelete(btn) {
        Swal.fire({
            title: 'Are you sure?',
            text: 'This will delete the User.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                btn.closest('form').submit(); // 🔥 POST happens here
            }
        });
    }
</script>