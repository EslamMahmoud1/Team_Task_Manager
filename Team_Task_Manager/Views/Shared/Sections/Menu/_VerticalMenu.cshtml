@using Team_Task_Manager.Shared
@{
  TempData.Keep();
  string? currentPage = ViewContext.HttpContext.Request.Path;
}

<!-- Menu -->
@* ! Do this simple *@
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">

  @* ! Hide app brand if navbar-full *@
  <div class='app-brand demo @((@ViewData["navbarFull"] != null && Convert.ToBoolean(@ViewData["navbarFull"])) ? "d-xl-none" : "")'>
    <a asp-controller="Dashboards" asp-action="Index" class="app-brand-link">
      <span class="app-brand-logo demo">
        @await Html.PartialAsync("../_Partials/_Macros")
      </span>
      <span class="app-brand-text demo menu-text fw-bold ms-2">@TempData.Peek("appName")</span>
    </a>

    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
      <i class="icon-base bx bx-chevron-left d-block d-xl-none align-middle"></i>
    </a>
  </div>

  <div class="menu-divider mt-0"></div>

  <div class="menu-inner-shadow"></div>




  @* ! Full version menu-items *@
  <ul class="menu-inner py-1">
      <!--Admin-->

        @if (PermissionHelper.HasPermission(User, PermissionName.AdminPanel))
        {
            <li class='menu-item@(currentPage == "/Cards/Basic" ? " active" : "")'>
                <a asp-controller="Users" asp-action="Index" class="menu-link">
                    <i class="menu-icon icon-base bx bx-collection"></i>
                    <div class="text-truncate" data-i18n="Cards">Manage Users</div>
                </a>
            </li>
        }

        @if (PermissionHelper.HasPermission(User, PermissionName.AdminPanel))
        {
            <li class='menu-item@(currentPage == "/Cards/Basic" ? " active" : "")'>
                <a asp-controller="Role" asp-action="Index" class="menu-link">
                    <i class="menu-icon icon-base bx bx-collection"></i>
                    <div class="text-truncate" data-i18n="Cards">Manage Roles</div>
                </a>
            </li>
        }

    <!-- Dashboards -->
        @if(PermissionHelper.HasAnyPermission(User, new[] { PermissionName.Analytics, PermissionName.CRM, PermissionName.eCommerce, PermissionName.Logistics, PermissionName.Academy }))
        {
            <li class='menu-item@(currentPage.EndsWith("/") || currentPage.StartsWith("/Dashboards/") ? " active open" : "")'>
                <a href="javascript:void(0);" class="menu-link menu-toggle">
                    <i class="menu-icon icon-base bx bx-home-smile"></i>
                    <div class="text-truncate" data-i18n="Dashboards">Dashboards</div>
                    <span class="badge rounded-pill bg-danger ms-auto">5</span>
                </a>
                <ul class="menu-sub">
                    @if (PermissionHelper.HasPermission(User, PermissionName.Analytics))
                    {
                        <li class='menu-item@(currentPage == "/" ? " active" : "")'>
                            <a asp-controller="Dashboards" asp-action="Index" class="menu-link">
                                <div class="text-truncate">Analytics</div>
                            </a>
                        </li>
                    }
                    @if (PermissionHelper.HasPermission(User, PermissionName.CRM))
                    {
                        <li class='menu-item@(currentPage == "/Dashboards/CRM" ? " active" : "")'>
                            <a asp-controller="Dashboard" asp-action="Index" class="menu-link">
                                <div class="text-truncate">Task Manager</div>
                            </a>
                        </li>
                    }
                    @if (PermissionHelper.HasPermission(User, PermissionName.eCommerce))
                    {
                        <li class='menu-item@(currentPage == "/Ecommerce/Dashboard" ? " active" : "")'>
                            <a asp-controller="Dashboards" asp-action="eCommerce" class="menu-link">
                                <div class="text-truncate">eCommerce</div>
                            </a>
                        </li>
                    }
                    @if (PermissionHelper.HasPermission(User, PermissionName.Logistics))
                    {
                        <li class='menu-item@(currentPage == "/Logistics/Dashboard" ? " active" : "")'>
                            <a asp-controller="Dashboards" asp-action="Logistics" class="menu-link">
                                <div class="text-truncate">Logistics</div>
                            </a>
                        </li>
                    }
                    @if (PermissionHelper.HasPermission(User, PermissionName.Academy))
                    {
                        <li class='menu-item@(currentPage == "/Academy/Dashboard" ? " active" : "")'>
                            <a asp-controller="Dashboards" asp-action="Academy" class="menu-link">
                                <div class="text-truncate">Academy</div>
                            </a>
                        </li>
                    }
                </ul>
            </li>
            
        }
        

    <!-- Layouts -->
        @if (PermissionHelper.HasAnyPermission(User, new[] { PermissionName.Withoutmenu, PermissionName.Withoutnavbar, PermissionName.Fluid, PermissionName.Container, PermissionName.Blank }))
        {
            <li class='menu-item@(currentPage.StartsWith("/LayoutExamples") ? " active open" : "")'>
                <a href="javascript:void(0);" class="menu-link menu-toggle">
                    <i class="menu-icon icon-base bx bx-layout"></i>
                    <div class="text-truncate">Layouts</div>
                </a>

                <ul class="menu-sub">
                    @if (PermissionHelper.HasPermission(User, PermissionName.Withoutmenu))
                    {
                        <li class='menu-item@(currentPage == "/LayoutExamples/WithoutMenu" ? " active" : "")'>
                            <a asp-controller="LayoutExamples" asp-action="WithoutMenu" class="menu-link">
                                <div class="text-truncate">Without menu</div>
                            </a>
                        </li>
                    }


                    @if (PermissionHelper.HasPermission(User, PermissionName.Withoutnavbar))
                    {
                    
                        <li class='menu-item@(currentPage == "/LayoutExamples/WithoutNavbar" ? " active" : "")'>
                            <a asp-controller="LayoutExamples" asp-action="WithoutNavbar" class="menu-link">
                                <div class="text-truncate">Without navbar</div>
                            </a>
                        </li>
                    }

                    @if (PermissionHelper.HasPermission(User, PermissionName.Fluid))
                    {
                        <li class='menu-item@(currentPage == "/LayoutExamples/Fluid" ? " active" : "")'>
                            <a asp-controller="LayoutExamples" asp-action="Fluid" class="menu-link">
                                <div class="text-truncate">Fluid</div>
                            </a>
                        </li>
                    }


                    @if (PermissionHelper.HasPermission(User, PermissionName.Container))
                    {
                        <li class='menu-item@(currentPage == "/LayoutExamples/Container" ? " active" : "")'>
                            <a asp-controller="LayoutExamples" asp-action="Container" class="menu-link">
                                <div class="text-truncate">Container</div>
                            </a>
                        </li>
                    }


                    @if (PermissionHelper.HasPermission(User, PermissionName.Blank))
                    {
                    
                        <li class='menu-item@(currentPage == "/LayoutExamples/Blank" ? " active" : "")'>
                            <a asp-controller="LayoutExamples" asp-action="Blank" class="menu-link">
                                <div class="text-truncate">Blank</div>
                            </a>
                        </li>
                    }

                </ul>
            </li>
        }
        

    <!-- Apps & Pages -->
    <li class="menu-header small text-uppercase">
      <span class="menu-header-text">Apps &amp; Pages</span>
    </li>
    <!-- Apps -->
    
    <!-- Pages -->
        @if (PermissionHelper.HasAnyPermission(User, new[] {PermissionName.Account, PermissionName.Notifications, PermissionName.Connections }))
        {
            <li class='menu-item@(currentPage.StartsWith("/Pages/Account") ? " active open" : "")'>
                <a href="javascript:void(0);" class="menu-link menu-toggle">
                    <i class="menu-icon icon-base bx bx-dock-top"></i>
                    <div class="text-truncate">Account Settings</div>
                </a>
                <ul class="menu-sub">
                    @if (PermissionHelper.HasPermission(User, PermissionName.Account))
                    {
                        <li class='menu-item@(currentPage == "/Pages/AccountSettings" ? " active" : "")'>
                            <a asp-controller="Pages" asp-action="AccountSettings" class="menu-link">
                                <div class="text-truncate">Account</div>
                            </a>
                        </li>
                    }

                    @if (PermissionHelper.HasPermission(User, PermissionName.Notifications))
                    {
                        <li class='menu-item@(currentPage == "/Pages/AccountSettingsNotifications" ? " active" : "")'>
                            <a asp-controller="Pages" asp-action="AccountSettingsNotifications" class="menu-link">
                                <div class="text-truncate">Notifications</div>
                            </a>
                        </li>
                    }


                    @if (PermissionHelper.HasPermission(User, PermissionName.Connections))
                    {
                        <li class='menu-item@(currentPage == "/Pages/AccountSettingsConnections" ? " active" : "")'>
                            <a asp-controller="Pages" asp-action="AccountSettingsConnections" class="menu-link">
                                <div class="text-truncate">Connections</div>
                            </a>
                        </li>
                    }



                </ul>
            </li>
        }

        <li class='menu-item@(currentPage.StartsWith("/Auth") ? " active open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon icon-base bx bx-lock-open-alt"></i>
                <div class="text-truncate">Authentications</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/Auth/LoginBasic" ? " active" : "")'>
                    <a asp-controller="Auth" asp-action="LoginBasic" class="menu-link" target="_blank">
                        <div class="text-truncate">Login</div>
                    </a>
                </li>


                @if (PermissionHelper.HasPermission(User, PermissionName.Register))
                {
                    <li class='menu-item@(currentPage == "/Auth/RegisterBasic" ? " active" : "")'>
                        <a asp-controller="Auth" asp-action="RegisterBasic" class="menu-link" target="_blank">
                            <div class="text-truncate">Create User</div>
                        </a>
                    </li>
                }


                @if (PermissionHelper.HasPermission(User, PermissionName.ForgotPassword))
                {
                    <li class='menu-item@(currentPage == "/Auth/ForgotPasswordBasic" ? " active" : "")'>
                        <a asp-controller="Auth" asp-action="ForgotPasswordBasic" class="menu-link" target="_blank">
                            <div class="text-truncate">Forgot Password</div>
                        </a>
                    </li>
                }

            </ul>
        </li>

    
    
    <!-- Misc -->
    <li class="menu-header small text-uppercase"><span class="menu-header-text">Misc</span></li>
    <li class="menu-item">
      <a href='@TempData.Peek("support")' target="_blank" class="menu-link">
        <i class="menu-icon icon-base bx bx-support"></i>
        <div class="text-truncate">Support</div>
      </a>
    </li>
    <li class="menu-item">
      <a href='@TempData.Peek("documentation")' target="_blank" class="menu-link">
        <i class="menu-icon icon-base bx bx-file"></i>
        <div class="text-truncate">Documentation</div>
      </a>
    </li>
  </ul>

</aside>
<!-- / Menu -->
