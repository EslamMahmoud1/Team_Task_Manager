<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@model IEnumerable<UserRoles>

@{
    ViewData["Title"] = "Index";
}

<h1>All Roles</h1>

<p>
    <a asp-controller="AdminPanel" asp-action="Index">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>

           
                <td>
                    <a asp-action="Details" class="btn btn-primary" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" class="btn btn-warning" asp-route-id="@item.Id">Edit</a> |
                    <form asp-controller="Role"
                          asp-action="DeleteConfirmed"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline;">
                        <button type="button"
                                class="btn btn-danger"
                                data-role-id="@item.Id"
                                onclick="confirmDelete(this)">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    function confirmDelete(btn) {
    var roleId = btn.getAttribute("data-role-id");
    var form = btn.closest('form');

    $.get('/Role/HasUsers', { roleId: roleId }, function(res) {

    if (res.hasUsers) {

    $.get('/Role/GetAllRoles', function(roles) {

    let options = '';
    roles.forEach(r => {
    if (r.id != roleId) {
    options += `<option value="${r.id}">${r.name}</option>`;
    }
    });

    Swal.fire({
    title: 'Role has assigned users!',
    html: `
    <p style="margin-bottom:10px;">
    ⚠️ This role has <b>${res.count}</b> user(s).
    </p>
    <p>Select a new role for them:</p>
    <select id="newRole" class="swal2-select">
    ${options}
    </select>
    `,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Reassign & Delete',
    confirmButtonColor: '#d33',
    preConfirm: () => {
    const newRoleId = document.getElementById('newRole').value;

    if (!newRoleId) {
    Swal.showValidationMessage('Please select a role');
    }

    return newRoleId;
    }
    }).then((result) => {

    if (result.isConfirmed) {

    Swal.fire({
    title: 'Processing...',
    text: 'Reassigning users...',
    allowOutsideClick: false,
    didOpen: () => {
    Swal.showLoading();
    }
    });

    $.ajax({
    url: '/Role/ReassignUsersAndDelete',
    type: 'POST',
    data: {
    roleId: roleId,
    newRoleId: result.value
    },
    success: function() {
    Swal.fire(
    'Done!',
    `${res.count} user(s) reassigned successfully.`,
    'success'
    ).then(() => location.reload());
    },
    error: function() {
    Swal.fire(
    'Error!',
    'Something went wrong.',
    'error'
    );
    }
    });
    }
    });

    });

    } else {

    // normal delete
    Swal.fire({
    title: 'Are you sure?',
    text: 'This will delete the role.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
    if (result.isConfirmed) {
    form.submit();
    }
    });

    }

    });
    }
</script>