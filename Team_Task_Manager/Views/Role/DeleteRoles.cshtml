@model RoleIndexViewModel

<h2>Roles</h2>

<form asp-action="Delete" method="post">

    <div class="form-group">
        <label>Select Role</label>
        <select asp-for="SelectedRoleId"
                asp-items="Model.Roles"
                class="form-control">
        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-danger">
        Delete Role
    </button>

</form>