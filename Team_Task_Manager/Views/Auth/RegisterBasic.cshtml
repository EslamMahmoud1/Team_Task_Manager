@using Team_Task_Manager.ViewModels.User
@model UserViewModel
@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Register Basic - Pages";
    var AllRoles = ViewBag.roles as List<UserRoles>;
}

@section PageStyles {
<link rel="stylesheet" href="~/vendor/css/pages/page-auth.css" />
}

@* ************** Content ************** *@
<div class="container-xxl">
  <div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">
      <!-- Register Card -->
      <div class="card px-sm-6 px-0">
        <div class="card-body">
          <!-- Logo -->
          <div class="app-brand justify-content-center mb-6">
            <a href="/" class="app-brand-link gap-2">
              <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
              <span class="app-brand-text demo text-heading fw-bold">@TempData.Peek("appName")</span>
            </a>
          </div>
          <!-- /Logo -->
          <h4 class="mb-1">Adventure starts here 🚀</h4>
          <p class="mb-6">Make your app management easy and fun!</p>

          <form asp-controller="User" asp-action="CreateUser" method="POST">
            <div class="mb-6">
              <label asp-for="Name" class="form-label">Username</label>
              <input asp-for="Name" class="form-control" placeholder="Enter your UserName" autofocus />
              <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-6">
              <label asp-for="Email" class="form-label">Email</label>
              <input asp-for="Email" class="form-control" placeholder="Enter your email" />
              <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-password-toggle">
              <label asp-for="Password" class="form-label">Password</label>
              <div class="input-group input-group-merge">
                <input asp-for="Password" class="form-control" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password" />
                <span asp-validation-for="Password" class="input-group-text cursor-pointer"></span>
              </div>
            </div>
            <div class="mb-6">
                <label for="SelectedRoleId" class="form-label">Role</label>
                <select id="SelectedRoleId" name="SelectedRoleId" class="form-control">
                    @foreach (var role in AllRoles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
            </div>
            <div class="my-7">
              
            </div>
            <button class="btn btn-primary d-grid w-100">Sign up</button>
          </form>

          <p class="text-center">
            <span>Already have an account?</span>
            <a href="/Auth/LoginBasic">
              <span>Sign in instead</span>
            </a>
          </p>
        </div>
      </div>
      <!-- Register Card -->
    </div>
  </div>
</div>
@section Scripts {
    <script src="~/vendor/libs/jquery/jquery.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}