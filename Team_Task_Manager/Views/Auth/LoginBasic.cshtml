@using Team_Task_Manager.ViewModels.User
@model SignInViewModel
@{
  Layout = "_BlankLayout";
  ViewData["Title"] = "Login Basic - Pages";
}

@section PageStyles {
<link rel="stylesheet" href="~/vendor/css/pages/page-auth.css" />
}

@* ************** Content ************** *@
<div class="container-xxl">
  <div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">
      <!-- Register -->
      <div class="card px-sm-6 px-0">
        <div class="card-body">
          <!-- Logo -->
          <div class="app-brand justify-content-center">
            <a href="/" class="app-brand-link gap-2">
              <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
              <span class="app-brand-text demo text-heading fw-bold">@TempData.Peek("appName")</span>
            </a>
          </div>
          <!-- /Logo -->
          <h4 class="mb-1">Welcome to @TempData.Peek("appName")! 👋</h4>
          <p class="mb-6">Please sign-in to your account and start the adventure</p>
          <form asp-controller="User" asp-action="CurrentUser" method="post">
              <div class="mb-6">
                  <label asp-for="Email" class="form-label"></label>
                  <input asp-for="Email" class="form-control" placeholder="Enter your email or username" />
                  <span asp-validation-for="Email" class="text-danger"></span>
              </div>

              <div class="mb-6 form-password-toggle">
                  <label asp-for="Password" class="form-label"></label>
                  <div class="input-group input-group-merge">
                      <input asp-for="Password" class="form-control" placeholder="••••••••" />
                      <span class="input-group-text cursor-pointer">
                          <i class="icon-base bx bx-hide"></i>
                      </span>
                  </div>
                  <span asp-validation-for="Password" class="text-danger"></span>
              </div>

              <div class="mb-6">
                  <button class="btn btn-primary d-grid w-100" type="submit">Login</button>
              </div>

          </form>
        </div>
      </div>
      <!-- /Register -->
    </div>
  </div>
</div>
@section Scripts {
    <script src="~/vendor/libs/jquery/jquery.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}