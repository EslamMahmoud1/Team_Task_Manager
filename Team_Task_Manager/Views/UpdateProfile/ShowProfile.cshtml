@using Team_Task_Manager.ViewModels.UpdateProfile
@model UserProfileViewModel

@{
    var fullName = $"{Model.PersonalInfo.FirstName} {Model.PersonalInfo.LastName}".Trim();
    var hasProfile = ViewBag.HasProfile as bool? ?? false;
}

<link rel="stylesheet" href="~/css/userprofile.css" asp-append-version="true" />

<style>
    .profile-page {
        max-width: 1100px;
    }

    .profile-hero {
        background: linear-gradient(135deg, #123c2b 0%, #1e8a5e 58%, #d4efe3 100%);
        border-radius: 18px;
        color: #fff;
        padding: 34px;
        box-shadow: var(--shadow);
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

    .profile-hero::after {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        right: -80px;
        top: -80px;
        background: rgba(255,255,255,0.16);
    }

    .profile-hero__content {
        display: flex;
        align-items: center;
        gap: 22px;
        position: relative;
        z-index: 1;
    }

    .profile-avatar {
        width: 104px;
        height: 104px;
        border-radius: 28px;
        background: rgba(255,255,255,0.18);
        border: 2px solid rgba(255,255,255,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
        font-size: 34px;
        font-weight: 700;
    }

    .profile-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-hero h1 {
        font-size: 32px;
        margin-bottom: 8px;
        color: #fff;
    }

    .profile-hero p {
        margin: 0;
        opacity: 0.9;
    }

    .profile-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
        flex-wrap: wrap;
    }

    .profile-actions .btn {
        text-decoration: none;
    }

    .profile-section {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 24px;
        margin-bottom: 20px;
    }

    .profile-section h2 {
        margin-bottom: 18px;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .profile-field {
        background: var(--gray-100);
        border: 1px solid var(--gray-200);
        border-radius: 10px;
        padding: 14px;
    }

    .profile-field span {
        color: var(--gray-600);
        display: block;
        font-size: 12px;
        letter-spacing: 0.04em;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    .profile-field strong {
        display: block;
        overflow-wrap: anywhere;
    }

    .profile-list {
        display: grid;
        gap: 14px;
    }

    .profile-card {
        border: 1px solid var(--gray-200);
        border-radius: 12px;
        padding: 16px;
        background: #fff;
    }

    .profile-card h3 {
        margin-bottom: 6px;
        font-size: 18px;
    }

    .profile-card p {
        color: var(--gray-600);
        margin: 0;
    }

    .skill-cloud {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .empty-profile {
        text-align: center;
        padding: 44px 24px;
    }

    @@media (max-width: 768px) {
        .profile-hero__content {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="layout">
    <aside class="sidebar">
        <ul>
            <li class="sidebar__item">
                <a asp-controller="UpdateProfile" asp-action="Index" style="color:inherit;text-decoration:none;">Update Profile</a>
            </li>
            <li class="sidebar__item sidebar__item--active">Show Profile</li>
        </ul>
    </aside>

    <main class="content profile-page">
        @if (!hasProfile)
        {
            <section class="profile-section empty-profile">
                <h2>No Profile Data Yet</h2>
                <p>Create your profile first, then it will appear here.</p>
                <div class="profile-actions" style="justify-content:center;">
                    <a asp-controller="UpdateProfile" asp-action="Index" class="btn btn--primary">Create Profile</a>
                </div>
            </section>
        }
        else
        {
            <section class="profile-hero">
                <div class="profile-hero__content">
                    <div class="profile-avatar">
                        @if (!string.IsNullOrWhiteSpace(Model.PersonalInfo.ProfilePictureUrl))
                        {
                            <img src="@Model.PersonalInfo.ProfilePictureUrl" alt="@fullName" />
                        }
                        else
                        {
                            @(string.IsNullOrWhiteSpace(fullName) ? "U" : fullName[0].ToString().ToUpper())
                        }
                    </div>

                    <div>
                        <h1>@(string.IsNullOrWhiteSpace(fullName) ? "Current User" : fullName)</h1>
                        <p>@Display(Model.PersonalInfo.Headline)</p>
                        <p>@Display(Model.PersonalInfo.Email)</p>

                        <div class="profile-actions">
                            <a asp-controller="UpdateProfile" asp-action="Index" class="btn btn--secondary">Edit Profile</a>
                        </div>
                    </div>
                </div>
            </section>

            <section class="profile-section">
                <h2>Personal Info</h2>
                <div class="profile-grid">
                    <div class="profile-field">
                        <span>First Name</span>
                        <strong>@Display(Model.PersonalInfo.FirstName)</strong>
                    </div>
                    <div class="profile-field">
                        <span>Last Name</span>
                        <strong>@Display(Model.PersonalInfo.LastName)</strong>
                    </div>
                    <div class="profile-field">
                        <span>Email</span>
                        <strong>@Display(Model.PersonalInfo.Email)</strong>
                    </div>
                    <div class="profile-field">
                        <span>Phone</span>
                        <strong>@Display(Model.PersonalInfo.Phone)</strong>
                    </div>
                    <div class="profile-field">
                        <span>Location</span>
                        <strong>@Display(Model.PersonalInfo.Location)</strong>
                    </div>
                    <div class="profile-field">
                        <span>Date of Birth</span>
                        <strong>@(Model.PersonalInfo.DateOfBirth?.ToString("MMM dd, yyyy") ?? "Not provided")</strong>
                    </div>
                </div>

                <div class="profile-field" style="margin-top:16px;">
                    <span>Bio</span>
                    <strong>@Display(Model.PersonalInfo.Bio)</strong>
                </div>
            </section>

            <section class="profile-section">
                <h2>Education</h2>
                @if (Model.Educations.Count == 0)
                {
                    <p>No education entries saved.</p>
                }
                else
                {
                    <div class="profile-list">
                        @foreach (var education in Model.Educations)
                        {
                            <article class="profile-card">
                                <h3>@Display(education.Institution)</h3>
                                <p>@Display(education.Degree) in @Display(education.FieldOfStudy)</p>
                                <p>Graduation Year: @education.GraduationYear</p>
                                @if (!string.IsNullOrWhiteSpace(education.Description))
                                {
                                    <p>@education.Description</p>
                                }
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="profile-section">
                <h2>Skills</h2>
                @if (Model.Skills.SkillNames.Count == 0)
                {
                    <p>No skills saved.</p>
                }
                else
                {
                    <div class="skill-cloud">
                        @foreach (var skill in Model.Skills.SkillNames)
                        {
                            <span class="skill-tag">@skill</span>
                        }
                    </div>

                    <div class="profile-grid">
                        <div class="profile-field">
                            <span>Proficiency Level</span>
                            <strong>@Display(Model.Skills.ProficiencyLevel)</strong>
                        </div>
                        <div class="profile-field">
                            <span>Years of Experience</span>
                            <strong>@Model.Skills.YearsOfExperience</strong>
                        </div>
                    </div>

                    <div class="profile-field" style="margin-top:16px;">
                        <span>Additional Notes</span>
                        <strong>@Display(Model.Skills.AdditionalNotes)</strong>
                    </div>
                }
            </section>
        }
    </main>
</div>

@functions {
    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
    }
}
